# =====================================================================
# UAMBite - Plantilla de configuración local (NO COMMITEAR)
# Copia este archivo como application-local.properties y rellena los
# valores reales. Para activarlo, lanza la app con:
#   --spring.profiles.active=local
# o define SPRING_PROFILES_ACTIVE=local en el entorno.
# =====================================================================

# Datasource
DATASOURCE_URL=jdbc:postgresql://localhost:5432/uambite
DATASOURCE_USERNAME=uambite
DATASOURCE_PASSWORD=your_db_password_here

# JWT
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long_for_HMAC_SHA256
JWT_EXPIRATION_MS=86400000

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Server
SERVER_PORT=8090
SERVER_CONTEXT_PATH=/api
