# =====================================================================
# UAMBite - Variables de entorno LOCALES
# Copia este archivo como .env en la raíz del proyecto y rellena:
#   cp .env.example .env
#
# Este archivo está en .gitignore. NO COMMITEAR.
# Spring Boot lo carga automáticamente al arrancar.
# =====================================================================

# Datasource (PostgreSQL)
DATASOURCE_URL=jdbc:postgresql://192.168.1.23:8927/uambite
DATASOURCE_USERNAME=uambite_admin
DATASOURCE_PASSWORD=tu_password_aqui

# JWT (mínimo 32 bytes; genera uno con: openssl rand -base64 48)
JWT_SECRET=tu_secreto_de_al_menos_32_bytes_aqui
JWT_EXPIRATION_MS=86400000

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Server
SERVER_PORT=8090
SERVER_CONTEXT_PATH=/api
